<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.lantern.probe">
  <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="Lantern probe" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
    <activity android:name=".AnimActivity" android:exported="true" android:documentLaunchMode="always" android:resizeableActivity="true" android:configChanges="screenSize|smallestScreenSize|orientation|keyboardHidden|density">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <receiver android:name=".CmdReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="dev.lantern.probe.CMD"/></intent-filter>
    </receiver>
    <service android:name=".ProbeIme" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
      <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/ime"/>
    </service>
    <service android:name=".ProbeNls" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
    </service>
  </application>
</manifest>
